{
  "expo": {
    "name": "GreenCollar",
    "slug": "greencollar",
    "scheme": "greencollar",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nsbtechnology.greencollar"
    },
    "android": {
      "package": "com.nsbtechnology.greencollar"
    },
    "web": {
      "name": "GreenCollar"
    },
    "plugins": [
      "expo-secure-store",
      ["@clerk/expo"],
      ["expo-location", {
        "locationWhenInUsePermission": "GreenCollar uses your location only when you choose to capture or check a service-site location.",
        "isIosBackgroundLocationEnabled": false,
        "isAndroidBackgroundLocationEnabled": false,
        "isAndroidForegroundServiceEnabled": false
      }]
    ]
  }
}
